    "prova:contatti": "tsx salone-app/frontend/lib/contatti.prova.ts",
    "prova:preconto": "tsx salone-app/frontend/lib/preconto.prova.ts",
    "prova:vetrina": "tsx salone-app/frontend/lib/vetrina.prova.ts",
    "prova:buoni": "tsx salone-app/frontend/lib/importa-buoni.prova.ts",
    "prova:funzioni": "tsx salone-app/frontend/lib/funzioni.prova.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
