rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // --- Chi lavora nel salone -------------------------------------------
    //
    // I documenti portano `userId` = l'identificativo del salone, che è quello
    // del titolare. Il titolare è quindi riconosciuto dal confronto diretto.
    // Le operatrici hanno un documento in `membri/{uid}` che dice a quale
    // salone appartengono e a quali pagine possono accedere.

    function percorsoMembro() {
      return /databases/$(database)/documents/membri/$(request.auth.uid);
    }

    function eMembro() {
      return isSignedIn() && exists(percorsoMembro());
    }

    function membro() {
      return get(percorsoMembro()).data;
    }

    /** Un accesso sospeso non entra: `attivo` assente vale come acceso. */
    function membroAttivo() {
      return !('attivo' in membro()) || membro().attivo == true;
    }

    /** Il salone è suo: o perché ne è il titolare, o perché ci lavora. */
    function nelSalone(userId) {
      return isSignedIn() && (
        request.auth.uid == userId
        || (eMembro() && membro().salonId == userId && membroAttivo())
      );
    }

    /** Come sopra, ma serve anche il permesso su quella pagina. */
    function nelSaloneCon(userId, permesso) {
      return isSignedIn() && (
        request.auth.uid == userId
        || (
          eMembro()
          && membro().salonId == userId
          && membroAttivo()
          && membro().permessi is list
          && membro().permessi.hasAny([permesso])
        )
      );
    }

    // --- Funzioni riservate -----------------------------------------------
    //
    // Certe pagine sono nate su richiesta di un salone solo e non riguardano
    // gli altri: i Buoni sono di RD Salon (buoni spa venduti online, il loro
    // foglio, la loro piega inclusa). L'interruttore è l'indirizzo del
    // **titolare** del salone, non di chi sta scrivendo: così le sue
    // operatrici ci arrivano, e un altro salone no.
    //
    // Lo stesso elenco sta in `salone-app/frontend/lib/funzioni.ts`, che
    // toglie la voce dal menù. Se si aggiunge un salone va cambiato in tutti
    // e due i posti: qui c'è la serratura, là solo la maniglia.

    function saloniConIBuoni() {
      return ['rdsalon.ceccano@gmail.com'];
    }

    function emailAbilitataAiBuoni(email) {
      return email is string && email.lower() in saloniConIBuoni();
    }

    /** L'indirizzo di chi sta scrivendo adesso: il titolare passa da qui. */
    function emailDiChiEntra() {
      return (isSignedIn() && ('email' in request.auth.token))
        ? request.auth.token.email
        : '';
    }

    /** L'indirizzo del titolare, letto dalla scheda del salone: le operatrici
        passano da qui, perché il loro non dice niente sul salone. */
    function emailDelSalone(userId) {
      return exists(/databases/$(database)/documents/salons/$(userId))
        ? get(/databases/$(database)/documents/salons/$(userId)).data.get('ownerEmail', '')
        : '';
    }

    /** True se quel salone ha la pagina dei Buoni. */
    function haIBuoni(userId) {
      return emailAbilitataAiBuoni(emailDiChiEntra())
        || emailAbilitataAiBuoni(emailDelSalone(userId));
    }



    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validatori della FORMA del documento.
    // A chi appartiene lo decidono nelSalone/nelSaloneCon: qui non si guarda
    // più `request.auth.uid`, altrimenti le operatrici — che hanno un uid
    // diverso da quello del salone — sarebbero respinte su tutto.
    function isValidAppuntamento(data) {
      return data.keys().hasAll(['userId', 'data_ora', 'stato'])
        && data.userId is string;
    }

    function isValidCliente(data) {
      return data.keys().hasAll(['userId', 'nome', 'cognome', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.nome is string && data.nome.size() <= 100
        && data.cognome is string && data.cognome.size() <= 100
        && ( !('telefono' in data) || (data.telefono is string && data.telefono.size() <= 50) )
        && ( !('note' in data) || (data.note is string && data.note.size() <= 500) )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDipendente(data) {
      return data.keys().hasAll(['userId', 'nome', 'cognome', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.nome is string && data.nome.size() <= 100
        && data.cognome is string && data.cognome.size() <= 100
        && ( !('ruolo' in data) || (data.ruolo is string && data.ruolo.size() <= 100) )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSalon(data) {
      return data.keys().hasAll(['ownerEmail', 'plan', 'createdAt'])
        && ( !('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 200) || data.ownerName == null )
        && data.ownerEmail is string && data.ownerEmail.size() <= 200
        && data.plan is string && data.plan.size() <= 32
        && data.createdAt is timestamp
        && ( !('settings' in data) || (data.settings is map) );
    }

    function isValidCatalogo(data) {
      return data.keys().hasAll(['userId', 'nome', 'durata_minuti'])
        && data.userId is string
        && data.nome is string && data.nome.size() <= 100
        && ( !('prezzo_base' in data) || (data.prezzo_base is number) )
        && ( !('prezzo' in data) || (data.prezzo is number) )
        && data.durata_minuti is number
        && ( !('note_private' in data) || (data.note_private is string) )
        && ( !('note_pubbliche' in data) || (data.note_pubbliche is string) )
        && ( !('attivo' in data) || (data.attivo is bool) )
        && ( !('descrizione' in data) || (data.descrizione is string && data.descrizione.size() <= 500) )
        && ( !('categoria' in data) || (data.categoria is string && data.categoria.size() <= 100) )
        && ( !('createdAt' in data) || (data.createdAt is timestamp) || (data.createdAt is string) );
    }

    match /catalogo/{itemId} {
      // NON è più pubblico: qui dentro ci sono le note private, i costi e i
      // margini. Chi prenota legge la vetrina, che ne porta fuori una copia
      // ripulita.
      allow get: if nelSalone(resource.data.userId);
      allow list: if nelSalone(resource.data.userId);
      allow create: if isValidId(itemId) && isValidCatalogo(incoming()) && nelSaloneCon(incoming().userId, 'catalogo');
      allow update: if isValidId(itemId) && isValidCatalogo(incoming()) && nelSaloneCon(resource.data.userId, 'catalogo');
      allow delete: if isValidId(itemId) && nelSaloneCon(resource.data.userId, 'catalogo');
    }

    match /categorie_catalogo/{catId} {
      allow get: if nelSalone(resource.data.userId);
      allow list: if nelSalone(resource.data.userId);
      allow create: if isValidId(catId)
                    && incoming().keys().hasAll(['userId', 'nome'])
                    && nelSaloneCon(incoming().userId, 'catalogo')
                    && incoming().nome is string && incoming().nome.size() <= 100;
      allow update: if isValidId(catId)
                    && incoming().keys().hasAll(['userId', 'nome'])
                    && nelSaloneCon(resource.data.userId, 'catalogo')
                    && incoming().userId == resource.data.userId
                    && incoming().nome is string && incoming().nome.size() <= 100;
      allow delete: if isValidId(catId) && nelSaloneCon(resource.data.userId, 'catalogo');
    }

    match /appuntamenti/{appuntamentoId} {
      // NON sono più leggibili da fuori. Era la fuga grossa: dentro ogni
      // appuntamento ci sono nome, cognome e telefono della cliente, e la
      // pagina di prenotazione li leggeva tutti solo per sapere quando le
      // operatrici erano occupate. Adesso quel dato sta in /disponibilita,
      // che di persone non ne contiene nessuna.
      allow get: if nelSaloneCon(resource.data.userId, 'agenda');
      allow list: if nelSaloneCon(resource.data.userId, 'agenda');
      allow create: if isValidId(appuntamentoId) && (
                      (isValidAppuntamento(incoming()) && nelSaloneCon(incoming().userId, 'agenda'))
                      || (incoming().source == 'web_public' && incoming().userId is string)
                    );
      allow update: if isValidId(appuntamentoId) && isValidAppuntamento(incoming()) && nelSaloneCon(resource.data.userId, 'agenda');
      allow delete: if isValidId(appuntamentoId) && nelSaloneCon(resource.data.userId, 'agenda');
    }

    match /clienti/{clienteId} {
      // L'agenda mostra il nome della cliente sull'appuntamento: chi ha
      // l'agenda deve poter leggere l'anagrafica, ma per modificarla serve il
      // permesso sui clienti.
      allow get: if nelSalone(resource.data.userId);
      allow list: if nelSalone(resource.data.userId);
      allow create: if isValidId(clienteId) && isValidCliente(incoming())
                    && nelSaloneCon(incoming().userId, 'clienti')
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      allow update: if isValidId(clienteId) && isValidCliente(incoming())
                    && nelSaloneCon(resource.data.userId, 'clienti')
                    && incoming().createdAt == resource.data.createdAt
                    && incoming().updatedAt == request.time;
      allow delete: if isValidId(clienteId) && nelSaloneCon(resource.data.userId, 'clienti');
    }

    match /dipendenti/{dipendenteId} {
      // NON è più pubblico: nella scheda c'è anche l'email. Chi prenota legge
      // la vetrina, dove restano solo nome, foto, turni e servizi.
      allow get: if nelSalone(resource.data.userId);
      allow list: if nelSalone(resource.data.userId);
      allow create: if isValidId(dipendenteId) && isValidDipendente(incoming())
                    && nelSaloneCon(incoming().userId, 'dipendenti')
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      allow update: if isValidId(dipendenteId) && isValidDipendente(incoming())
                    && nelSaloneCon(resource.data.userId, 'dipendenti')
                    && incoming().createdAt == resource.data.createdAt
                    && incoming().updatedAt == request.time;
      allow delete: if isValidId(dipendenteId) && nelSaloneCon(resource.data.userId, 'dipendenti');
    }

    // I buoni sono una funzione riservata: oltre al permesso sulla pagina
    // serve che il salone ce l'abbia (vedi `haIBuoni` più sopra). Senza questa
    // riga, un altro salone potrebbe scriversi i buoni a mano dalla console
    // del browser anche senza vedere la voce nel menù.
    match /buoni/{buonoId} {
      allow get: if nelSaloneCon(resource.data.userId, 'buoni')
                    && haIBuoni(resource.data.userId);
      allow list: if nelSaloneCon(resource.data.userId, 'buoni')
                    && haIBuoni(resource.data.userId);
      allow create: if isValidId(buonoId)
                    && incoming().keys().hasAll(['userId', 'codice', 'valore', 'stato'])
                    && nelSaloneCon(incoming().userId, 'buoni')
                    && haIBuoni(incoming().userId)
                    && incoming().codice is string && incoming().codice.size() <= 40
                    && incoming().valore is number && incoming().valore >= 0
                    && incoming().stato is string && incoming().stato.size() <= 20;
      allow update: if isValidId(buonoId)
                    && nelSaloneCon(resource.data.userId, 'buoni')
                    && haIBuoni(resource.data.userId)
                    && incoming().userId == resource.data.userId;
      allow delete: if isValidId(buonoId)
                    && nelSaloneCon(resource.data.userId, 'buoni')
                    && haIBuoni(resource.data.userId);
    }

    // ---------------------------------------------------------------------
    // Quello che vede il mondo esterno
    // ---------------------------------------------------------------------
    //
    // Due sole porte aperte, e da nessuna delle due esce una persona.

    /** Listino e operatrici, ripuliti: niente note private, niente email. */
    match /vetrina/{salonId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isSignedIn() && request.auth.uid == salonId
                            && incoming().userId == salonId;
      allow delete: if false;
    }

    /**
     * Gli orari occupati. Chi la legge sa che qualcuno è preso dalle 15 alle
     * 16, non chi né per cosa. La pagina di prenotazione può scriverci —
     * altrimenti due clienti prenderebbero le stesse 15:00 — ma solo righe
     * fatte di orari: la forma è controllata qui sotto.
     */
    match /disponibilita/{appuntamentoId} {
      allow get: if true;
      allow list: if true;
      // Forma ammessa: solo orari, niente altro.
      function formaDisponibilita() {
        return incoming().keys().hasOnly(['userId', 'giorno', 'fasce'])
          && incoming().userId is string
          && incoming().giorno is string && incoming().giorno.size() <= 10
          && incoming().fasce is list && incoming().fasce.size() <= 50;
      }

      // Chi prenota dal sito può creare SOLO la riga dell'appuntamento che ha
      // appena preso, e solo se quell'appuntamento esiste davvero in quel
      // salone. Senza questo legame chiunque potrebbe riempire l'agenda di
      // occupazioni finte e bloccare le prenotazioni.
      function rigaDiUnAppuntamentoVero() {
        return exists(/databases/$(database)/documents/appuntamenti/$(appuntamentoId))
          && get(/databases/$(database)/documents/appuntamenti/$(appuntamentoId)).data.userId == incoming().userId;
      }

      allow create: if isValidId(appuntamentoId) && formaDisponibilita()
                    && ( nelSaloneCon(incoming().userId, 'agenda') || rigaDiUnAppuntamentoVero() );
      // Riscrivere una riga già esistente tocca solo al salone.
      allow update: if isValidId(appuntamentoId) && formaDisponibilita()
                    && nelSaloneCon(resource.data.userId, 'agenda')
                    && incoming().userId == resource.data.userId;
      allow delete: if nelSaloneCon(resource.data.userId, 'agenda');
    }

    // Chi lavora nel salone. Ognuna legge solo la propria riga; a scriverle è
    // solo la titolare del salone a cui la riga punta. Le due condizioni sulla
    // stessa riga sono quello che tiene in piedi tutto il resto: se una si
    // potesse cambiare da sola i permessi, i permessi non varrebbero niente.
    match /membri/{membroUid} {
      allow get: if isSignedIn() && (
                      request.auth.uid == membroUid
                      || request.auth.uid == resource.data.salonId
                    );
      allow list: if isSignedIn() && request.auth.uid == resource.data.salonId;
      allow create: if isSignedIn()
                    && isValidId(membroUid)
                    && incoming().keys().hasAll(['salonId', 'nome', 'permessi'])
                    && incoming().salonId == request.auth.uid
                    && incoming().nome is string && incoming().nome.size() <= 200
                    && incoming().permessi is list && incoming().permessi.size() <= 20
                    && ( !('attivo' in incoming()) || incoming().attivo is bool )
                    && ( !('idDipendente' in incoming()) || incoming().idDipendente is string );
      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.salonId
                    && incoming().salonId == resource.data.salonId
                    && incoming().permessi is list && incoming().permessi.size() <= 20;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.salonId;
    }

    match /salons/{salonId} {
      allow read: if true;
      allow list: if false;
      allow create: if isSignedIn() && salonId == request.auth.uid
                    && isValidSalon(incoming())
                    && incoming().createdAt == request.time;
      allow update: if isSignedIn() && salonId == request.auth.uid
                    && isValidSalon(incoming())
                    && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }
  }
}
